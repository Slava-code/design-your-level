# Copy to .env.local (never committed). Real values live only in .env.local and in Vercel env settings.
# TEAM_CODES, ADMIN_CODE and SESSION_SECRET are generated by: node scripts/gen-codes.mjs

# Use a dedicated OpenAI project with a hard monthly spend limit
OPENAI_API_KEY=
# Comma-separated team join codes, 3 words each; position in the list = Team N
TEAM_CODES=
# Admin login code (longer than team codes)
ADMIN_CODE=
# 32 random bytes as hex; signs the session cookies
SESSION_SECRET=
# Public URL of the site (projector QR code and printed cards)
PLAY_URL=http://localhost:3000
# Per-team AI budget in dollars
TEAM_BUDGET_USD=5
# Neon Postgres (pooled; the database in this URL is production)
DATABASE_URL=
# Neon direct connection, used by scripts/migrate.mjs (falls back to DATABASE_URL)
DATABASE_URL_UNPOOLED=
# Vercel Blob store
BLOB_READ_WRITE_TOKEN=

# Optional overrides (defaults in src/lib/ai/config.ts and src/lib/server/config.ts)
# TEXT_MODEL=gpt-6-luna
# IMAGE_MODEL=gpt-image-2.6-flare
# IMAGE_QUALITY=high
# IMAGE_MODERATION=low
# JOIN_RATE_PER_MIN=20
# JOIN_RATE_PER_HOUR=120

# Development only (never on Vercel production)
# DEV_DB_NAME=dyl_dev_backend
# MOCK_AI=1
# MOCK_AI_DELAY_MS=1500
