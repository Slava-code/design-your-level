{
  "name": "design-your-level",
  "version": "1.0.0",
  "private": true,
  "description": "Kahoot-style classroom party game: teams describe a video game level in words, an AI draws it as a storyboard, the class votes, then reflects on what the AI got wrong.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Slava-code/design-your-level.git"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "print-codes": "node scripts/print-codes.mjs",
    "build:qa": "NEXT_DIST_DIR=.next-qa next build",
    "test:e2e": "playwright test",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "next": "16.4.2",
    "openai": "^7.41.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
